{
  "name": "koalashot",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first full-page screenshot extension foundation.",
  "scripts": {
    "icons": "node scripts/run-python.cjs scripts/generate_icons.py",
    "lint": "eslint extension landing scripts tests",
    "audit:docs": "node scripts/audit-docs.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:archives": "node scripts/run-python.cjs tests/archive_validation_test.py",
    "test:regressions": "node tests/browser/audit-regressions.test.mjs",
    "test:usability": "node tests/browser/usability.test.mjs",
    "test:website": "node tests/browser/landing.test.mjs",
    "test": "npm run verify",
    "test:browser": "node tests/browser/extension-flow.test.mjs",
    "test:browser:chrome": "node scripts/run-browser-matrix.mjs chrome",
    "test:browser:firefox": "node scripts/run-browser-matrix.mjs firefox",
    "test:browser:matrix": "node scripts/run-browser-matrix.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "store:screenshots": "node scripts/capture-store-assets.mjs",
    "build": "node scripts/run-python.cjs scripts/build.py",
    "validate": "node scripts/run-python.cjs scripts/validate.py",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "eslint": "^10.8.1"
  }
}
